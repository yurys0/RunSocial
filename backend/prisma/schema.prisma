generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrackerProviderName {
  STRAVA
  ADIDAS // Runtastic API (Adidas Running)
  PACER
}

enum TrackerAccountStatus {
  ACTIVE
  ERROR
  DISCONNECTED
}

enum FriendLinkStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id          String   @id
  login       String   @unique
  displayName String
  avatarUrl   String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trackerAccounts     TrackerAccount[]
  activities          Activity[]
  likes               ActivityLike[]
  sentFriendLinks     FriendLink[]     @relation("FriendLinkFrom")
  receivedFriendLinks FriendLink[]     @relation("FriendLinkTo")
}

model TrackerAccount {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider             TrackerProviderName
  encryptedCredentials String
  externalUserId       String?
  status               TrackerAccountStatus @default(ACTIVE)
  lastSyncAt           DateTime?
  createdAt            DateTime             @default(now())

  activities Activity[]

  @@unique([userId, provider])
}

model Activity {
  id String @id @default(uuid())

  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackerAccountId String
  trackerAccount   TrackerAccount @relation(fields: [trackerAccountId], references: [id], onDelete: Cascade)

  externalId      String
  distanceMeters  Int
  durationSeconds Int
  avgPaceSecPerKm Int
  startedAt       DateTime
  endedAt         DateTime?

  routePoints Json?
  rawPayload  Json

  createdAt DateTime @default(now())

  likes ActivityLike[]

  @@unique([trackerAccountId, externalId])
  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

model FriendLink {
  id         String @id @default(uuid())
  fromUserId String
  fromUser   User   @relation("FriendLinkFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("FriendLinkTo", fields: [toUserId], references: [id], onDelete: Cascade)

  status    FriendLinkStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
}

model ActivityLike {
  id String @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, activityId])
  @@index([activityId])
}
