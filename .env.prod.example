# cp .env.prod.example .env
# заполнить всё, помеченное «заполнить», дальше docker compose up -d --build
# наружу смотрит только caddy на 80 и 443, остальное живёт в docker-сети

API_PORT=3000

# образы, собранные в CI; без них compose соберёт их локально
BACKEND_IMAGE=ghcr.io/ВЛАДЕЛЕЦ/runsocial-backend:latest
FRONTEND_IMAGE=ghcr.io/ВЛАДЕЛЕЦ/runsocial-frontend:latest

# embedded-s3 — свой minio рядом с приложением, https — caddy с сертификатом.
# с внешним S3-провайдером оставить только https
COMPOSE_PROFILES=embedded-s3,https

# заполнить: домен с a-записью на этот сервер; порты 80 и 443 должны быть открыты
PUBLIC_DOMAIN=
# заполнить: почта для let's encrypt, на неё придёт предупреждение об истечении
ACME_EMAIL=

# postgres
POSTGRES_USER=runsocial
# заполнить: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=runsocial
POSTGRES_PORT=5432
# заполнить тем же паролем, что и выше
DATABASE_URL=postgresql://runsocial:ПАРОЛЬ@postgres:5432/runsocial?schema=public

# redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_CACHE_DB=0
REDIS_QUEUE_DB=1

# s3
# встроенный minio (профиль embedded-s3) или внешний провайдер:
# Yandex — https://storage.yandexcloud.net, регион ru-central1; AWS — https://s3.<регион>.amazonaws.com
S3_ENDPOINT=http://minio:9000
S3_REGION=ru-central1
S3_BUCKET=runsocial
# заполнить: для своего minio это его логин и пароль, openssl rand -base64 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
# у AWS S3 поставить false, остальные работают в path-style
S3_FORCE_PATH_STYLE=true

# auth: пароли, сессии и роли хранит SuperTokens
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567
# заполнить: openssl rand -hex 32
SUPERTOKENS_API_KEY=
# заполнить: https:// и тот же домен, что в PUBLIC_DOMAIN — к нему привязаны cookie сессии
PUBLIC_ORIGIN=
# заполнить: openssl rand -hex 32, ровно 64 символа.
# при смене ключа старые привязки трекеров перестанут расшифровываться
TRACKER_CREDENTIALS_SECRET=


# наружу трафик пускает caddy
FRONTEND_PORT=8081

# за сколько месяцев тянуть историю при первой синхронизации
TRACKER_INITIAL_SYNC_MONTHS=60
# короче этого не импортируется вообще; 0 — не отсекать
TRACKER_MIN_DISTANCE_METERS=1000

# креды трекеров: заполнять только нужные, без них привязка вернёт ошибку авторизации
STRAVA_BASE_URL=https://www.strava.com
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# прокси, если api трекера недоступен с сервера: http://user:pass@host:port
STRAVA_PROXY=

RUNTASTIC_BASE_APPWS_URL=https://appws.runtastic.com
RUNTASTIC_BASE_HUBS_URL=https://hubs.runtastic.com
RUNTASTIC_CLIENT_ID=
RUNTASTIC_CLIENT_SECRET=
RUNTASTIC_APP_KEY=com.runtastic.android
RUNTASTIC_APP_VERSION=13.46
RUNTASTIC_PROXY=

PACER_BASE_URL=https://api.pacer.cc
PACER_CLIENT_ID=
PACER_SECRET_KEY=
PACER_PRODUCT=pacer
PACER_VERSION=p12.2.2
PACER_LOCALE=ru_RU
PACER_LANGUAGE=ru
PACER_TIMEZONE=Europe/Moscow
PACER_TIMEZONE_OFFSET=180
PACER_PROXY=

# vite_* вшиваются в бандл при сборке: после правки нужен docker compose build frontend
VITE_API_URL=/api
# заполнить: ключ яндекс.карт, в кабинете привязан к рабочему домену
VITE_YANDEX_MAPS_API_KEY=
